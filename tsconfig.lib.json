{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["src/icons", "src/components", "src/theme", "src/index.web.ts", "src/index.native.ts"],
  "exclude": ["src/stories", "src/svg", "node_modules", "dist", "**/*.stories.tsx", "**/*.test.tsx"]
}
